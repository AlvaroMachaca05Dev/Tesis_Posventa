@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 120
skinparam roundCorner 8
skinparam ArrowColor #44546a
skinparam ClassBackgroundColor #f4f8fc
skinparam ClassBorderColor #44546a
skinparam PackageBackgroundColor #ffffff
skinparam NoteBackgroundColor #fff8e1

title Modelo de datos de logística, inventario y automatizaciones
hide circle
entity solicitud_producto {
  *id\n#tarea_id\ndescripcion\ncantidad\nestado
}
entity cotizacion_producto {
  *id\n#solicitud_id\nproveedor\ncosto\nventa
}
entity conformidad {
  *id\n#solicitud_id\nresultado\nobservacion
}
entity producto {
  *id\ncodigo\nnombre\ncategoria
}
entity almacen {
  *id\n#local_id\nnombre
}
entity requerimiento {
  *id\ncodigo\n#origen_id\n#destino_id\nestado
}
entity item_requerimiento {
  *id\n#requerimiento_id\n#producto_id\ncantidad
}
entity kardex {
  *id\n#almacen_id\n#producto_id\ntipo\ncantidad\nfecha
}
entity automatizacion {
  *id\nevento\ncondicion\naccion\nactiva
}
entity encuesta {
  *id\n#orden_id\nenlace\npuntaje\nrespuesta
}
solicitud_producto ||--o{ cotizacion_producto
solicitud_producto ||--o| conformidad
requerimiento ||--o{ item_requerimiento
producto ||--o{ item_requerimiento
producto ||--o{ kardex
almacen ||--o{ kardex
@enduml
