@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 120
skinparam roundCorner 8
skinparam ArrowColor #44546a
skinparam ClassBackgroundColor #f4f8fc
skinparam ClassBorderColor #44546a
skinparam PackageBackgroundColor #ffffff
skinparam NoteBackgroundColor #fff8e1
hide empty members
skinparam classAttributeIconSize 0

title Clases del núcleo: identidad, maestros y órdenes de servicio
class Organizacion {
  nombre
  ruc
  activa
}
class ModuloHabilitado {
  modulo
}
class Local {
  nombre
  direccion
}
class Usuario {
  nombre
  correo
  activo
}
class Rol {
  nombre
  ambito (plataforma | empresa)
  esBase
  nivel (1 a 5)
  asignableAServicios
}
class Permiso {
  modulo
  nivel (A | E | V)
}
class Cliente {
  nombre
  documento
}
class Vehiculo {
  placa
  marca
  modelo
  anio
}
class Proveedor {
  nombre
  documento
}
class Kilometraje {
  km
  fecha
  fuente
}
class OrdenServicio {
  codigo
  estado
  fechaLlegada
  km
  cerrar()
  reabrir()
}
class DetalleODS {
  descripcion
  observacion
}
class ServicioODS {
  duracionPlanificada
  responsable
  cantidadHH
}
class Evidencia {
  archivo
  tipo
}
Organizacion "1" o-- "*" Local
Organizacion "1" o-- "*" ModuloHabilitado
Organizacion "1" o-- "*" Rol : roles de la empresa
Organizacion "1" o-- "*" Usuario
Local "1" o-- "*" Usuario
Usuario "*" -- "1..*" Rol : uno o más roles
Rol "*" -- "*" Permiso
Organizacion "1" o-- "*" Cliente
Cliente "1" o-- "*" Vehiculo
Vehiculo "1" o-- "*" Kilometraje
Vehiculo "1" <-- "*" OrdenServicio
Local "1" <-- "*" OrdenServicio
OrdenServicio "1" *-- "*" DetalleODS
DetalleODS "1" *-- "*" ServicioODS
OrdenServicio "1" o-- "*" Evidencia
ServicioODS "*" --> "1" Usuario : responsable
@enduml
