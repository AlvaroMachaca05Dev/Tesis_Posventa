@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 120
skinparam roundCorner 8
skinparam ArrowColor #44546a
skinparam ClassBackgroundColor #f4f8fc
skinparam ClassBorderColor #44546a
skinparam PackageBackgroundColor #ffffff
skinparam NoteBackgroundColor #fff8e1
hide empty members
skinparam classAttributeIconSize 0

title Clases del núcleo: identidad, maestros y órdenes de servicio
class Organizacion {
  nombre
  ruc
  activa
}
class ModuloHabilitado {
  modulo
}
class Local {
  nombre
  direccion
}
class Usuario {
  nombre
  correo
  activo
}
class Rol {
  nombre
  ambito (plataforma | empresa)
  esBase
  nivel (1 a 5)
  asignableAServicios
}
class Permiso {
  modulo
  nivel (A | E | V)
}
class Cliente {
  tipoDocumento : DNI, CE o RUC
  documento : único por empresa
  nombre
  nombreComercial
  pais
  movil
  direccionFiscal
  email
  ubigeo
  comentario
  esGenerico
  activo
  fechaRegistro
}
class Vehiculo {
  placa : única sin guiones
  marca
  modelo
  anio
  color
  nroSerie
  nroVin
  nroMotor
  comentario
  fechaRegistro
}
class Proveedor {
  nombre
  documento
}
class Kilometraje {
  km
  fecha
  fuente
  observacion
}
class OrdenServicio {
  codigo : AAAAMMDD + correlativo
  estado
  decisionCliente
  tipoAtencion
  fechaInicio : llegada
  fechaCierre : solo al pasar a Cerrada
  km
  observaciones
  recomendaciones
  cerrar() : sin nota, solo si No aprobada
  reabrir()
}
class DetalleODS {
  tipo : servicio o producto
  descripcion
  referencia
  cantidad : H-H en servicios
  costo
  rentabilidadPct
  precio : final, con impuesto
  descuentoPct
  impuesto : IGV o ninguno
  total
}
class Abono {
  fecha
  metodo
  concepto
  valor
}
class ServicioODS {
  duracionPlanificada
  responsable
  cantidadHH
}
class Evidencia {
  archivo
  tipo
}
Organizacion "1" o-- "*" Local
Organizacion "1" o-- "*" ModuloHabilitado
Organizacion "1" o-- "*" Rol : roles de la empresa
Organizacion "1" o-- "*" Usuario
Local "1" o-- "*" Usuario
Usuario "*" -- "1..*" Rol : uno o más roles
Rol "*" -- "*" Permiso
Organizacion "1" o-- "*" Cliente
Cliente "1" o-- "*" Vehiculo
Vehiculo "1" o-- "*" Kilometraje
Vehiculo "1" <-- "*" OrdenServicio
Local "1" <-- "*" OrdenServicio
OrdenServicio "1" *-- "*" DetalleODS
OrdenServicio "1" *-- "*" Abono
OrdenServicio "*" --> "0..1" Usuario : técnico y jefe de taller
DetalleODS "1" *-- "*" ServicioODS
OrdenServicio "1" o-- "*" Evidencia
ServicioODS "*" --> "1" Usuario : responsable
@enduml
