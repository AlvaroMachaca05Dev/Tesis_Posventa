@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 120
skinparam roundCorner 8
skinparam ArrowColor #44546a
skinparam ClassBackgroundColor #f4f8fc
skinparam ClassBorderColor #44546a
skinparam PackageBackgroundColor #ffffff
skinparam NoteBackgroundColor #fff8e1
autonumber
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 18

title Cita, llegada, ODS, tareas y agenda técnica
actor Cajera
actor "Jefe de taller" as J
actor Técnico as T
participant "API" as A
participant "Agenda" as AG
database "PostgreSQL" as DB
Cajera -> A : crear cita (cliente, vehículo, servicios)
A -> AG : validarCapacidad(técnico, franja)
AG --> A : máximo dos bloques simultáneos
A -> DB : guarda cita y bloques
Cajera -> A : registrar llegada del vehículo
A -> DB : crea una única ODS en Recepción y enlaza los bloques
A -> DB : crea tarea técnica por servicio
J -> A : asignar tarea o reprogramar (con aviso y reconfirmación)
T -> A : iniciar, pausar o dividir el bloque
A -> AG : validarCapacidad(otro día u hora)
alt hay hueco libre
  A -> DB : continúa el mismo servicio sin crear uno nuevo
else empalme
  A --> T : rechaza y propone otro hueco
end
T -> A : ampliar duración (motivo opcional)
A -> DB : registra tiempo real, no cambia el precio
A -> DB : bitácora y auditoría de cada cambio
@enduml
