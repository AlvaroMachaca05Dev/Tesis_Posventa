@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 120
skinparam roundCorner 8
skinparam ArrowColor #44546a
skinparam ClassBackgroundColor #f4f8fc
skinparam ClassBorderColor #44546a
skinparam PackageBackgroundColor #ffffff
skinparam NoteBackgroundColor #fff8e1
hide empty members
skinparam classAttributeIconSize 0

title Clases de automatizaciones, consulta de kilometraje, encuesta y reportes
left to right direction
class Automatizacion {
  evento\ncondicion\naccion\nactiva
}
class ReglaDisparo {
  cambioDeEstado\ncierreDeOrden\nkmCercano
}
class ConsultaKm {
  km\nfecha\nmedio (Llamada | WhatsApp | Otro)
}
class Encuesta {
  enlace\nrespuesta\npuntaje
}
class Metrica {
  nombre\nperiodo\nvalor\nnps
}
class ReporteOperativo {
  nombre\nexportar()
}
class Indicador {
  nombre\nformula
}
class Filtro {
  local\nfecha\ntecnico\nvehiculo\nestado
}
class Tarea
class Vehiculo
class OrdenServicio
Automatizacion "1" *-- "*" ReglaDisparo
Automatizacion ..> Tarea : crea
OrdenServicio ..> Encuesta : al cerrar
Vehiculo "1" o-- "*" ConsultaKm
ConsultaKm ..> Automatizacion : recalcula proyección
Encuesta ..> Metrica : alimenta el NPS
ReporteOperativo "1" o-- "*" Indicador
ReporteOperativo "1" --> "1" Filtro
Indicador ..> Metrica
@enduml
