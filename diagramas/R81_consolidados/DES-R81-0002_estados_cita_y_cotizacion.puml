@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 120
skinparam roundCorner 8
skinparam ArrowColor #44546a
skinparam ClassBackgroundColor #f4f8fc
skinparam ClassBorderColor #44546a
skinparam PackageBackgroundColor #ffffff
skinparam NoteBackgroundColor #fff8e1
skinparam StateBackgroundColor #f4f8fc
skinparam StateBorderColor #44546a

title Estados de la cita y de la cotización
state "Cita" as CI {
  [*] --> Programada
  Programada --> Llegó : llegada (crea la ODS)
  Programada --> Cancelada
  Programada --> Inasistió
  Llegó --> Completada
}
state "Cotización" as C {
  [*] --> Borrador
  Borrador --> Emitida : emitir
  Emitida --> Aprobada : el cliente aprueba
  Emitida --> Rechazada
  Aprobada --> ConvertidaEnODS : pasar a ODS
}
CI -[hidden]-> C
@enduml
