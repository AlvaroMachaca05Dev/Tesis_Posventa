@startuml
!include _estilo.iuml
title Cierre, reapertura y corrección de una ODS
|Jefe de taller|
start
:Detectar un error en una ODS cerrada;
:Solicitar la corrección o la reapertura;
|Administrador|
if (¿Autoriza?) then (sí)
  if (¿Reabrir?) then (sí)
    |Sistema|
    :Pasar la ODS a En proceso;
    :Borrar la fecha de cierre;
    |Jefe de taller|
    :Corregir y volver a cerrar;
    |Sistema|
    :Poner la nueva fecha de cierre;
  else (no)
    |Sistema|
    :Guardar la corrección con\nel antes y el después (RN-13);
  endif
  |Sistema|
  fork
    :Registrar en la auditoría;
  fork again
    :Registrar en la bitácora;
  fork again
    :Recalcular el plan si\ncambió un servicio;
  end fork
else (no)
  |Sistema|
  :Mantener la ODS cerrada\ny registrar el rechazo;
endif
stop
@enduml
