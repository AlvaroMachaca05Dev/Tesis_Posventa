@startuml
!include _estilo.iuml
title Modelo de datos de planes, servicios y proyecciones
hide circle
left to right direction
entity plan_preventivo {
  *id
  --
  #organizacion_id
  codigo (único)
  nombre
  combustible, uso, aceite
  ciclo (JSON: visitas en orden)
  activo
}
entity vehiculo {
  *id
  --
  #plan_id
  #grupo_id
  placa_norm (única)
  codigo_motor
  uso, aceite
}
entity cambio_plan_vehiculo {
  *id
  --
  #vehiculo_id
  #usuario_id
  antes, despues
  corte, km
  creado_en
}
entity servicio {
  *id
  --
  codigo (único)
  nombre, categoria
  etiqueta, linea_plan, visita
  subservicios (JSON)
  pasos (JSON)
  horas_estandar, precio_estandar
  precios_grupo (JSON)
}
entity grupo_vehicular {
  *id
  --
  codigo (único)
}
entity lectura_km {
  *id
  --
  #vehiculo_id
  km, fecha, fuente
}
entity proyeccion <<pendiente>> {
  *id
  --
  #vehiculo_id
  #servicio_id
  km_estimado, fecha_estimada
  estado
}
entity reajuste <<pendiente>> {
  *id
  --
  #orden_id
  #usuario_id
  motivo, fecha
}
plan_preventivo |o--o{ vehiculo
grupo_vehicular |o--o{ vehiculo
vehiculo ||--o{ lectura_km
vehiculo ||--o{ cambio_plan_vehiculo
vehiculo ||--o{ proyeccion
servicio ||--o{ proyeccion
reajuste ||--o{ proyeccion
note bottom of plan_preventivo : El ciclo nombra el paquete de cada\nvisita (express, menor, mayor…),\nque es un servicio con subservicios.
note bottom of cambio_plan_vehiculo : Cada cambio de uso o de aceite parte\nla línea de tiempo en la última visita.
note bottom of proyeccion : Pendiente: reajuste con reglas de reinicio.
@enduml
