@startuml
!include _estilo.iuml
title Modelo de datos comercial, de compras y de cuentas
hide circle
left to right direction
entity cotizacion {
  *id
  --
  #organizacion_id
  #local_id
  #cliente_id
  #vehiculo_id
  serie, numero (únicos)
  valida_hasta
  condicion
  gravada, igv, total
  estado
}
entity detalle_cotizacion {
  *id
  --
  #cotizacion_id
  tipo, descripcion
  cantidad, precio
  descuento_pct, tipo_igv
  total
}
entity nota_venta {
  *id
  --
  #organizacion_id
  #local_id
  #orden_id (nulo en venta directa)
  #cliente_id
  serie, numero (únicos)
  condicion
  gravada, igv, total
  con_detraccion, detraccion
  estado
}
entity detalle_nota {
  *id
  --
  #nota_id
  tipo, descripcion
  cantidad, precio
  descuento_pct, tipo_igv
  total
}
entity correlativo_serie {
  *organizacion_id, serie
  --
  ultimo
}
entity abono {
  *id
  --
  #orden_id
  #nota_id
  fecha, metodo, valor
}
entity compra {
  *id
  --
  #organizacion_id
  #local_id
  #proveedor_id
  tipo_documento, serie, numero
  condicion
  fecha_vencimiento
  total, estado
}
entity detalle_compra {
  *id
  --
  #compra_id
  #producto_id
  cantidad, costo, total
}
entity pago_compra {
  *id
  --
  #compra_id
  fecha, metodo, valor
}
entity orden_servicio {
  *id
}
entity cliente {
  *id
}
entity proveedor {
  *id
}
entity producto {
  *id
}
entity movimiento_inventario {
  *id
  --
  #producto_id
  #local_id
  entrada, salida, saldo
}
cotizacion ||--|{ detalle_cotizacion
cliente ||--o{ cotizacion
nota_venta ||--|{ detalle_nota
cliente ||--o{ nota_venta
orden_servicio |o--o{ nota_venta
nota_venta |o--o{ abono
orden_servicio |o--o{ abono
proveedor ||--o{ compra
compra ||--|{ detalle_compra
compra ||--o{ pago_compra
producto |o--o{ detalle_compra
producto ||--o{ movimiento_inventario
note bottom of correlativo_serie : El número de cada serie se toma\ndentro de la transacción (RN-03).
note bottom of pago_compra : Las cuentas bancarias y sus\nmovimientos (RF-091) están pendientes.
@enduml
