@startuml
!include _estilo.iuml
title Clases de tareas, citas, vistas y bitácora
left to right direction
enum EstadoTarea <<enumeration>> {
  PENDIENTE
  EN_PROCESO
  EN_ESPERA
  COMPLETADA
  ARCHIVADA
}
enum EstadoCita <<enumeration>> {
  PENDIENTE
  CONFIRMADA
  REPROGRAMADA
  ATENDIDA
  NO_CONCRETADA
}
abstract class Agendable {
  #fechaHora: DateTime
  #duracionEstimada: Decimal
  #observaciones: String [0..1]
  +reprogramar(in fechaHora: DateTime): void
}
class Tarea {
  -tipo: String
  -estado: EstadoTarea = PENDIENTE
  -duracionReal: Decimal [0..1]
  -fechaCierre: DateTime [0..1]
  +iniciar(): void
  +completar(in duracionReal: Decimal): void
  +archivar(): void
}
class Cita {
  -codigo: String {unique}
  -estado: EstadoCita = PENDIENTE
  -tipoAtencion: String
  -km: Integer [0..1]
  -recomendaciones: String [0..1]
  +confirmar(): void
  +marcarAtendida(): void
  +crearODS(): OrdenServicio
}
class Vista {
  -tipo: String
  -nombre: String
  -filtros: Json
  -columnas: String [0..*]
  +duplicar(in nombre: String): Vista
}
class Cotizacion
class OrdenServicio {
  -citaOrigen: String [0..1]
}
class Bitacora {
  -texto: String
  -menciones: String [0..*]
  -fecha: DateTime {readOnly}
}
class Evidencia {
  -archivo: String
  -tipo: String
}
class Auditoria {
  -actor: String
  -antes: Json [0..1]
  -despues: Json [0..1]
  -motivo: String [0..1]
  -fecha: DateTime {readOnly}
}
class Usuario
Agendable <|-- Tarea
Agendable <|-- Cita
note top of Agendable : {complete, disjoint}
Tarea ..> EstadoTarea
Cita ..> EstadoCita
OrdenServicio "1" *-- "0..*" Tarea : una por ítem
Cita "0..1" -- "0..1" Cotizacion : asigna o crea
OrdenServicio "0..1" --> "0..1" Cita : se crea desde
OrdenServicio "0..1" -- "0..1" Cotizacion : enlaza
Usuario "1" *-- "0..*" Vista : guarda sus filtros
Usuario "1" <-- "0..*" Tarea : responsable
Usuario "1" <-- "0..*" Cita : creadaPor
Tarea "0..1" o-- "0..*" Bitacora
OrdenServicio "0..1" o-- "0..*" Bitacora
Bitacora "1" *-- "0..*" Evidencia
OrdenServicio ..> Auditoria : <<create>>
note bottom of Vista : Tareas y citas se ven en lista,\ntablero o calendario (día, 4 días,\nsemana, mes; pasos de 15 min).
@enduml
