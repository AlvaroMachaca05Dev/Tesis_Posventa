@startuml
!include _estilo.iuml
title Clases de planes preventivos, ficha del servicio, línea de tiempo y reajuste
left to right direction
enum EstadoProyeccion <<enumeration>> {
  PROXIMA
  VENCIDA
  REALIZADA
  DESCARTADA
}
class PlanPreventivo {
  -codigo: String {unique}
  -nombre: String
  -combustible: String
  -uso: String
  -aceite: String = "M"
  -ciclo: Visita [1..*] {ordered}
  -activo: Boolean = true
  +duplicar(): PlanPreventivo
  +sugerirA(in v: Vehiculo): Boolean
}
class Visita <<datatype>> {
  -orden: Integer
  -paquete: String
  -kmIntervalo: Integer
  -conAfinamiento: Boolean = false
}
class Servicio {
  -codigo: String {unique}
  -nombre: String
  -etiqueta: String [0..1]
  -lineaPlan: String [0..1]
  -visita: String [0..1]
  -subservicios: Subservicio [0..*]
  -pasos: String [0..*]
  /-horas: Decimal
}
class Subservicio <<datatype>> {
  -nombre: String
  -horas: Decimal
}
class Vehiculo {
  -codigoMotor: String [0..1]
  -uso: String [0..1]
  -aceite: String [0..1]
  +asignarPlan(in p: PlanPreventivo): void
  +cambiarUsoOAceite(in uso: String, in aceite: String): CambioPlanVehiculo
}
class CambioPlanVehiculo {
  -antes: String
  -despues: String
  -corte: String
  -km: Integer [0..1]
  -usuario: String
  -creadoEn: DateTime {readOnly}
}
class LineaTemporal <<utility>> {
  {static} +generar(in v: Vehiculo, in lecturas: LecturaKm [0..*]): Tramo [1..*]
  {static} +estado(in visita: Visita, in km: Integer): String
}
class Tramo <<datatype>> {
  -plan: String
  -desde: String
  -visitas: Visita [0..*]
}
class GrupoVehicular
class LecturaKm
class OrdenServicio
class Usuario
class Proyeccion <<pendiente>> {
  -kmEstimado: Integer
  -fechaEstimada: DateTime
  -estado: EstadoProyeccion = PROXIMA
}
class Reajuste <<pendiente>> {
  -motivo: String
  -fecha: DateTime {readOnly}
  +reajustarFuturo(in v: Vehiculo, in o: OrdenServicio): Proyeccion [0..*]
}
PlanPreventivo "1" *-- "1..*" Visita
Visita "0..*" --> "1" Servicio : paquete de la visita
Servicio "1" *-- "0..*" Subservicio
PlanPreventivo "0..1" o-- "0..*" Vehiculo : asignado
PlanPreventivo ..> GrupoVehicular : sugiere por grupo
Vehiculo "0..*" --> "0..1" GrupoVehicular
Vehiculo "1" *-- "0..*" LecturaKm
Vehiculo "1" *-- "0..*" CambioPlanVehiculo : parte la línea
CambioPlanVehiculo "0..*" --> "1" Usuario : quién lo hizo
LineaTemporal ..> Tramo : <<create>>
LineaTemporal ..> CambioPlanVehiculo : <<call>>
Tramo "1" o-- "0..*" Visita
Vehiculo "1" *-- "0..*" Proyeccion
Reajuste "0..*" --> "1" OrdenServicio : motivado por
Reajuste "0..*" --> "1" Usuario : responsable
Reajuste ..> Proyeccion : <<create>>
Proyeccion ..> EstadoProyeccion
note right of Reajuste : Pendiente: las reglas de reinicio\npor servicio y el reajuste de\nlas proyecciones futuras. El\nhistorial realizado nunca se modifica.
note bottom of PlanPreventivo : Ocho planes por código: gasolina o diésel,\nparticular o profesional, aceite mineral (M)\no sintético (S): GP-M, GP-S, GR-M, GR-S,\nDP-M, DP-S, DR-M y DR-S (DEC-119).
@enduml
