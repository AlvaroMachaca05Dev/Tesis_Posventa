{
  "name": "@posventa/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/src/main.js",
    "test": "dotenv -e ../../.env -- jest --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "testTimeout": 30000
  },
  "dependencies": {
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/jwt": "^10",
    "@nestjs/platform-express": "^10",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "22",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "5.6.3"
  }
}
