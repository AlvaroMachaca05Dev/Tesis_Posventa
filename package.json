{
  "name": "posventa-taller",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema database/prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
