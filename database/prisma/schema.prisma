// Esquema del núcleo (Sprint 1). Fuente: diagrama DMD-R81-0001.
// Decisiones del 27/10/2026: roles como datos por empresa, varios roles por usuario,
// datos de negocio ligados a su empresa (multiempresa preparado, una empresa activa) y módulos habilitados por empresa.
// Cualquier cambio pasa por la skill guardian-coherencia-tesis.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organizacion {
  id          String             @id @default(uuid())
  nombre      String
  ruc         String?
  activa      Boolean            @default(true)
  paisPredeterminado String      @default("PE")
  locales     Local[]
  roles       Rol[]
  usuarios    Usuario[]
  modulos     ModuloHabilitado[]
  clientes    Cliente[]
  vehiculos   Vehiculo[]
  marcasVehiculo MarcaVehiculo[]
  ordenes     OrdenServicio[]
}

// Qué módulos tiene contratados cada empresa. Lo define el Propietario de la plataforma.
model ModuloHabilitado {
  organizacionId String
  modulo         String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  @@id([organizacionId, modulo])
}

model Local {
  id             String          @id @default(uuid())
  organizacionId String
  nombre         String
  direccion      String?
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id])
  usuarios       Usuario[]
  ordenes        OrdenServicio[]
}

// Los roles son datos: los base se crean por empresa y el Superadministrador puede crear roles propios.
// organizacionId vacío = rol de plataforma (Propietario).
model Rol {
  id             String        @id @default(uuid())
  organizacionId String?
  nombre         String
  ambito         String        @default("empresa") // "plataforma" | "empresa"
  esBase         Boolean       @default(false)
  // Nivel jerárquico: 5 Desarrollador, 4 Superadministrador, 3 Administrador, 2 Jefe de taller, 1 Cajera, Técnico, Logístico y roles propios.
  // Un usuario solo gestiona roles de nivel inferior al suyo.
  nivel          Int           @default(1)
  // Si la persona puede aparecer en la agenda y recibir servicios (Técnico y Jefe de taller sí; el Administrador no).
  asignableAServicios Boolean  @default(false)
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])
  usuarios       UsuarioRol[]
  permisos       RolPermiso[]

  @@unique([organizacionId, nombre])
}

// Un permiso es un módulo con un nivel: A (ver, editar y acciones sensibles), E (ver y editar) o V (solo ver).
// Sin enlace = sin acceso.
model Permiso {
  id     String       @id @default(uuid())
  modulo String
  accion String
  roles  RolPermiso[]

  @@unique([modulo, accion])
}

model RolPermiso {
  rolId     String
  permisoId String
  rol       Rol     @relation(fields: [rolId], references: [id])
  permiso   Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
}

model Usuario {
  id             String        @id @default(uuid())
  organizacionId String?
  localId        String?
  nombre         String
  correo         String        @unique
  passwordHash   String
  activo         Boolean       @default(true)
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])
  local          Local?        @relation(fields: [localId], references: [id])
  roles          UsuarioRol[]
  detalles       DetalleODS[]
  bitacora       Bitacora[]
  odsTecnico     OrdenServicio[] @relation("OdsTecnico")
  odsJefe        OrdenServicio[] @relation("OdsJefe")
  odsCreadas     OrdenServicio[] @relation("OdsCreador")
  abonos         Abono[]
  evidencias     EvidenciaIngreso[]
}

// Un usuario puede tener uno o más roles; sus permisos son la suma de los de cada rol.
model UsuarioRol {
  usuarioId String
  rolId     String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  rol       Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
}

model Cliente {
  id              String        @id @default(uuid())
  organizacionId  String
  tipoDocumento   TipoDocumento @default(DNI)
  documento       String
  nombre          String
  nombreComercial String?
  pais            String        @default("PE")
  movil           String?
  direccionFiscal String?
  email           String?
  ubigeo          String?
  comentario      String?
  esGenerico      Boolean       @default(false)
  activo          Boolean       @default(true)
  creadoEn        DateTime      @default(now())
  organizacion    Organizacion  @relation(fields: [organizacionId], references: [id])
  vehiculos       Vehiculo[]
  ordenes         OrdenServicio[]

  @@unique([organizacionId, documento])
}

enum TipoDocumento {
  DNI
  CARNET_EXTRANJERIA
  RUC
}

model Vehiculo {
  id             String          @id @default(uuid())
  organizacionId String
  clienteId      String
  placa          String
  // La placa sin guiones, espacios ni minúsculas: sirve para comparar y buscar (única por empresa).
  placaNorm      String
  marca          String?
  modelo         String?
  anio           Int?
  color          String?
  nroSerie       String?
  nroVin         String?
  nroMotor       String?
  comentario     String?
  grupo          String?
  creadoEn       DateTime        @default(now())
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id])
  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  lecturas       LecturaKm[]
  ordenes        OrdenServicio[]

  @@unique([organizacionId, placaNorm])
}

// Marcas y modelos de vehículo de la empresa (catálogo del prototipo).
model MarcaVehiculo {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  modelos        String[]
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  @@unique([organizacionId, nombre])
}

model LecturaKm {
  id         String   @id @default(uuid())
  vehiculoId String
  km         Int
  fecha      DateTime
  fuente     String
  observacion String?
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])
}

model OrdenServicio {
  id              String       @id @default(uuid())
  organizacionId  String
  vehiculoId      String
  clienteId       String
  localId         String
  // AAAAMMDD + correlativo de la empresa (DEC-67); las externas llevan «E» delante y no usan correlativo
  codigo          String
  correlativo     Int?
  externa         Boolean      @default(false)
  estado          String       @default("Recepcion")
  decision        String       @default("Pendiente de aprobación")
  tipoAtencion    String
  fechaInicio     DateTime     @default(now())
  fechaCierre     DateTime?
  km              Int?
  tecnicoId       String?
  jefeTallerId    String?
  creadoPorId     String
  observaciones   String?
  recomendaciones String?
  // Estado del vehículo al ingresar (combustible, fluidos, inventario, documentos, daños): lista de chequeo (RF-015)
  estadoVehiculo  Json?
  eliminada       Boolean      @default(false)
  motivoEliminacion String?
  creadoEn        DateTime     @default(now())
  organizacion    Organizacion @relation(fields: [organizacionId], references: [id])
  vehiculo        Vehiculo     @relation(fields: [vehiculoId], references: [id])
  cliente         Cliente      @relation(fields: [clienteId], references: [id])
  local           Local        @relation(fields: [localId], references: [id])
  tecnico         Usuario?     @relation("OdsTecnico", fields: [tecnicoId], references: [id])
  jefeTaller      Usuario?     @relation("OdsJefe", fields: [jefeTallerId], references: [id])
  creadoPor       Usuario      @relation("OdsCreador", fields: [creadoPorId], references: [id])
  detalles        DetalleODS[]
  abonos          Abono[]
  bitacora        Bitacora[]
  evidencias      EvidenciaIngreso[]

  @@unique([organizacionId, codigo])
}

// Último correlativo de ODS por empresa: un número usado nunca se reutiliza.
model CorrelativoODS {
  organizacionId String @id
  ultimo         Int    @default(0)
}

model DetalleODS {
  id              String        @id @default(uuid())
  ordenId         String
  posicion        Int           @default(0)
  tipo            String        @default("servicio")
  descripcion     String
  referencia      String?
  cantidad        Decimal       @default(1) @db.Decimal(12, 3)
  costo           Decimal?      @db.Decimal(12, 3)
  rentabilidadPct Decimal?      @db.Decimal(8, 3)
  // precio de venta final por unidad, con el impuesto incluido (DEC-73)
  precio          Decimal       @default(0) @db.Decimal(12, 3)
  descuentoPct    Decimal       @default(0) @db.Decimal(6, 3)
  impuesto        String        @default("IGV")
  total           Decimal       @default(0) @db.Decimal(12, 2)
  tecnicoId       String?
  orden           OrdenServicio @relation(fields: [ordenId], references: [id])
  tecnico         Usuario?      @relation(fields: [tecnicoId], references: [id])
}

// Abono o pago antes del comprobante (DEC-28): reduce el saldo, no el total.
model Abono {
  id               String        @id @default(uuid())
  ordenId          String
  fecha            DateTime      @default(now())
  metodo           String
  concepto         String?
  valor            Decimal       @db.Decimal(12, 2)
  registradoPorId  String
  orden            OrdenServicio @relation(fields: [ordenId], references: [id])
  registradoPor    Usuario       @relation(fields: [registradoPorId], references: [id])
}

// Fotos y videos del vehículo al ingresar (RF-015). El archivo se guarda en la base para no depender de un disco aparte.
model EvidenciaIngreso {
  id          String        @id @default(uuid())
  ordenId     String
  nombre      String
  tipo        String
  tamano      Int
  datos       Bytes
  subidoPorId String
  creadoEn    DateTime      @default(now())
  orden       OrdenServicio @relation(fields: [ordenId], references: [id])
  subidoPor   Usuario       @relation(fields: [subidoPorId], references: [id])
}

model Bitacora {
  id         String         @id @default(uuid())
  ordenId    String?
  actorId    String
  texto      String
  fecha      DateTime       @default(now())
  orden      OrdenServicio? @relation(fields: [ordenId], references: [id])
  actor      Usuario        @relation(fields: [actorId], references: [id])
  evidencias Evidencia[]
}

model Evidencia {
  id         String   @id @default(uuid())
  bitacoraId String
  archivo    String
  tipo       String
  bitacora   Bitacora @relation(fields: [bitacoraId], references: [id])
}

// Auditoría: guarda quién hizo el cambio y, si actuaba «como» otra persona (Ver como…), también eso.
model Auditoria {
  id             String   @id @default(uuid())
  organizacionId String?
  tabla          String
  registroId     String
  actor          String
  actuandoComo   String?
  antes          Json?
  despues        Json?
  motivo         String?
  fecha          DateTime @default(now())
}
