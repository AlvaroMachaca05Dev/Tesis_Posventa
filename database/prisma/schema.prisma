// Esquema del núcleo (Sprint 1). Fuente: diagrama DMD-R81-0001.
// Decisiones del 27/10/2026: roles como datos por empresa, varios roles por usuario,
// datos de negocio ligados a su empresa (multiempresa preparado, una empresa activa) y módulos habilitados por empresa.
// Cualquier cambio pasa por la skill guardian-coherencia-tesis.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organizacion {
  id          String             @id @default(uuid())
  nombre      String
  ruc         String?
  activa      Boolean            @default(true)
  locales     Local[]
  roles       Rol[]
  usuarios    Usuario[]
  modulos     ModuloHabilitado[]
  clientes    Cliente[]
  vehiculos   Vehiculo[]
  ordenes     OrdenServicio[]
}

// Qué módulos tiene contratados cada empresa. Lo define el Propietario de la plataforma.
model ModuloHabilitado {
  organizacionId String
  modulo         String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  @@id([organizacionId, modulo])
}

model Local {
  id             String          @id @default(uuid())
  organizacionId String
  nombre         String
  direccion      String?
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id])
  usuarios       Usuario[]
  ordenes        OrdenServicio[]
}

// Los roles son datos: los base se crean por empresa y el Superadministrador puede crear roles propios.
// organizacionId vacío = rol de plataforma (Propietario).
model Rol {
  id             String        @id @default(uuid())
  organizacionId String?
  nombre         String
  ambito         String        @default("empresa") // "plataforma" | "empresa"
  esBase         Boolean       @default(false)
  // Nivel jerárquico: 5 Desarrollador, 4 Superadministrador, 3 Administrador, 2 Jefe de taller, 1 Cajera, Técnico, Logístico y roles propios.
  // Un usuario solo gestiona roles de nivel inferior al suyo.
  nivel          Int           @default(1)
  // Si la persona puede aparecer en la agenda y recibir servicios (Técnico y Jefe de taller sí; el Administrador no).
  asignableAServicios Boolean  @default(false)
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])
  usuarios       UsuarioRol[]
  permisos       RolPermiso[]

  @@unique([organizacionId, nombre])
}

// Un permiso es un módulo con un nivel: A (ver, editar y acciones sensibles), E (ver y editar) o V (solo ver).
// Sin enlace = sin acceso.
model Permiso {
  id     String       @id @default(uuid())
  modulo String
  accion String
  roles  RolPermiso[]

  @@unique([modulo, accion])
}

model RolPermiso {
  rolId     String
  permisoId String
  rol       Rol     @relation(fields: [rolId], references: [id])
  permiso   Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
}

model Usuario {
  id             String        @id @default(uuid())
  organizacionId String?
  localId        String?
  nombre         String
  correo         String        @unique
  passwordHash   String
  activo         Boolean       @default(true)
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])
  local          Local?        @relation(fields: [localId], references: [id])
  roles          UsuarioRol[]
  detalles       DetalleODS[]
  bitacora       Bitacora[]
}

// Un usuario puede tener uno o más roles; sus permisos son la suma de los de cada rol.
model UsuarioRol {
  usuarioId String
  rolId     String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  rol       Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
}

model Cliente {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  documento      String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])
  vehiculos      Vehiculo[]

  @@unique([organizacionId, documento])
}

model Vehiculo {
  id             String          @id @default(uuid())
  organizacionId String
  clienteId      String
  placa          String
  marca          String?
  modelo         String?
  anio           Int?
  grupo          String?
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id])
  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  lecturas       LecturaKm[]
  ordenes        OrdenServicio[]

  @@unique([organizacionId, placa])
}

model LecturaKm {
  id         String   @id @default(uuid())
  vehiculoId String
  km         Int
  fecha      DateTime
  fuente     String
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])
}

model OrdenServicio {
  id             String       @id @default(uuid())
  organizacionId String
  vehiculoId     String
  localId        String
  codigo         String
  estado         String       @default("Recepcion")
  fechaLlegada   DateTime
  km             Int?
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])
  vehiculo       Vehiculo     @relation(fields: [vehiculoId], references: [id])
  local          Local        @relation(fields: [localId], references: [id])
  detalles       DetalleODS[]
  bitacora       Bitacora[]

  @@unique([organizacionId, codigo])
}

model DetalleODS {
  id              String        @id @default(uuid())
  ordenId         String
  descripcion     String
  cantidadHH      Decimal?      @db.Decimal(6, 2)
  tecnicoId       String?
  duracionMinutos Int?
  orden           OrdenServicio @relation(fields: [ordenId], references: [id])
  tecnico         Usuario?      @relation(fields: [tecnicoId], references: [id])
}

model Bitacora {
  id         String         @id @default(uuid())
  ordenId    String?
  actorId    String
  texto      String
  fecha      DateTime       @default(now())
  orden      OrdenServicio? @relation(fields: [ordenId], references: [id])
  actor      Usuario        @relation(fields: [actorId], references: [id])
  evidencias Evidencia[]
}

model Evidencia {
  id         String   @id @default(uuid())
  bitacoraId String
  archivo    String
  tipo       String
  bitacora   Bitacora @relation(fields: [bitacoraId], references: [id])
}

// Auditoría: guarda quién hizo el cambio y, si actuaba «como» otra persona (Ver como…), también eso.
model Auditoria {
  id             String   @id @default(uuid())
  organizacionId String?
  tabla          String
  registroId     String
  actor          String
  actuandoComo   String?
  antes          Json?
  despues        Json?
  motivo         String?
  fecha          DateTime @default(now())
}
