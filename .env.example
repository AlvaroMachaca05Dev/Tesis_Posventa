# Copia este archivo a .env y no lo subas nunca al repositorio.
# Valores de desarrollo local; en cualquier otro entorno se cambian.
# Base de desarrollo: PostgreSQL embebido (pnpm db:dev). Con Docker Compose es el puerto 5432.
DATABASE_URL="postgresql://posventa:posventa_dev@localhost:54329/posventa_utf8?schema=public"
JWT_SECRET="cambiar-en-cada-entorno"
# Contraseña de las cuentas de demostración (solo desarrollo)
SEED_PASSWORD="Demo-2026-dev"
API_PORT=3000
WEB_PORT=5173

# Pantalla de ingreso en modo demostración (solo desarrollo; nunca en una instalación real)
VITE_DEMO_MODE=true
VITE_DEMO_CORREO="superusuario@rmotriz.com"
VITE_DEMO_PASSWORD=""

# Consulta de DNI (RENIEC) y RUC (SUNAT) desde el formulario de clientes y proveedores.
# La clave se queda en el servidor. Por defecto se usa apis.net.pe; otra API se configura con las dos direcciones ({numero} se reemplaza).
CONSULTA_DOC_TOKEN=""
CONSULTA_DOC_URL_DNI=""
CONSULTA_DOC_URL_RUC=""

# Consulta vehicular por placa desde el formulario de vehículos (marca, modelo, año, color, serie, VIN y motor).
# CONSULTA_PLACA_URL lleva {placa} (y, si el proveedor pide la clave en la dirección, {token}); si no hay CONSULTA_PLACA_TOKEN se usa CONSULTA_DOC_TOKEN.
CONSULTA_PLACA_URL=""
CONSULTA_PLACA_TOKEN=""
