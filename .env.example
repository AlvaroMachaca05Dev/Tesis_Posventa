# Copia este archivo a .env y no lo subas nunca al repositorio.
# Valores de desarrollo local; en cualquier otro entorno se cambian.
# Base de desarrollo: PostgreSQL embebido (pnpm db:dev). Con Docker Compose es el puerto 5432.
DATABASE_URL="postgresql://posventa:posventa_dev@localhost:54329/posventa?schema=public"
JWT_SECRET="cambiar-en-cada-entorno"
# Contraseña de las cuentas de demostración (solo desarrollo)
SEED_PASSWORD="Demo-2026-dev"
API_PORT=3000
WEB_PORT=5173

# Pantalla de ingreso en modo demostración (solo desarrollo; nunca en una instalación real)
VITE_DEMO_MODE=true
VITE_DEMO_CORREO="superusuario@rmotriz.com"
VITE_DEMO_PASSWORD=""
